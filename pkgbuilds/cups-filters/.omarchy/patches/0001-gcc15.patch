Build with GCC 15, which makes incompatible pointer types an error: foomatic-rip's start_process call trips it.

--- a/PKGBUILD
+++ b/PKGBUILD
@@ -20,4 +20,6 @@
 build() {
   cd "$pkgname"-$pkgver
+  # GCC 15 rejects foomatic-rip's start_process() argument types
+  export CFLAGS+=" -Wno-error=incompatible-pointer-types"
   ./configure --prefix=/usr  \
     --sysconfdir=/etc \
