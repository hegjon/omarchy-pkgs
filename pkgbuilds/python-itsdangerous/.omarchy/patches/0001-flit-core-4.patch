Build with flit-core 4: the pyproject pin on flit_core<4 predates it and nothing needs it.

--- a/PKGBUILD
+++ b/PKGBUILD
@@ -27,3 +27,5 @@
 build() {
   cd ${pkgname#python-}-$pkgver
+  # flit_core<4 is a pin, not a need: flit-core 4 builds it (Arch has 4.0.2)
+  sed -i 's/,<4"/"/; s/flit_core<4,\?/flit_core/' pyproject.toml
   python -m build --wheel --no-isolation
