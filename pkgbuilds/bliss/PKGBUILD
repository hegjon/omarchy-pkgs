# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=bliss
pkgver=0.77
pkgrel=5
pkgdesc='A library for computing automorphism groups and canonical forms of graphs'
arch=(x86_64)
url='https://users.aalto.fi/~tjunttil/bliss/'
license=(GPL-3.0-only)
depends=(glibc
         libgcc
         libstdc++)
       # gmp disabled, causes segfaults
makedepends=(cmake
             git)
source=(git+https://github.com/scipopt/bliss#tag=v$pkgver)
sha256sums=('883739bd63117eed51a613e9ea0a71c0a56751e0fa068fa3166fa421dacdec0b')

prepare() {
  sed -e '/hidden/d' -i bliss/CMakeLists.txt
}

build() {
  cmake -B build -S bliss \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DUSE_GMP=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
