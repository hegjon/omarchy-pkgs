# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: justforlxz <justforlxz@gmail.com>

pkgname=deepin-shell
pkgver=2.0.54
pkgrel=1
pkgdesc='New DDE shell'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-shell"
license=('CC-BY-4.0' 'CC0-1.0' 'GPL-3.0-or-later' 'LGPL-2.0-or-later' 'LGPL-3.0-or-later' 'MIT')
depends=('deepin-application-manager' 'deepin-tray-loader' 'dtk6core' 'dtk6gui' 'dtk6widget'
         'dtk6declarative' 'glibc' 'icu' 'libgcc' 'libstdc++' 'libx11' 'libxcb' 'libxtst' 'qt6-5compat'
         'qt6-base' 'qt6-declarative' 'qt6-wayland' 'xcb-util-wm' 'wayland' 'yaml-cpp')
makedepends=('git' 'extra-cmake-modules' 'cmake' 'ninja' 'qt6-tools' 'wayland-protocols'
             'treeland-protocols' 'gtest')
groups=('deepin')
replaces=('deepin-dock')
conflicts=('deepin-dock')
source=("git+https://github.com/linuxdeepin/dde-shell.git#tag=$pkgver")
sha512sums=('727dd7d8ca225af9ae6c113f6bda3157210ea537f183a578749cc27fda3d2c3b817706bcbf9e511031e06ce06ac997affc11586cdd18210c3360cf3983ecbce1')

prepare() {
  cd dde-shell
  # Qt 6.10 support: https://github.com/linuxdeepin/dde-shell/pull/1735
  git cherry-pick -n fb18e7a4eca9daf917cf367f903f66d6f8be982a
  # GCC 16 support: https://github.com/linuxdeepin/dde-shell/pull/1736
  git cherry-pick -n 19ac675da9bdae2d51e2d9107e7c75f09c66a201
  sed -i '/target_compile_definitions(dde-shell-dock PRIVATE DS_LIB)/d' panels/dock/frame/CMakeLists.txt
}

build() {
  cd dde-shell
  cmake . -GNinja \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build .
}

check() {
  ctest --test-dir dde-shell --output-on-failure
}

package() {
  cd dde-shell
  DESTDIR="$pkgdir" ninja install
}
