Build with GCC 15: crypt-gost-yescrypt.c discards a const qualifier, which -Werror turns fatal (as for libxcrypt).

--- a/PKGBUILD
+++ b/PKGBUILD
@@ -18,4 +18,6 @@
 build() {
   export CC="gcc -m32"
   export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"
+  # GCC 15: crypt-gost-yescrypt.c initializes a pointer from a const one
+  export CFLAGS+=" -Wno-error=discarded-qualifiers"
 
