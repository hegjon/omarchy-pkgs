Subject: [PATCH 2/2] test: fix bcrypt tests

based on https://github.com/notypecheck/passlib/commit/68e583357a29dc5d93afa66c1077c73d5168afa3
Use pytest fixture to detect if backend raises on long passwords and
skip affected tests when backend raises.
---
 passlib/tests/conftest.py             | 24 ++++++++++++++++++++++++
 passlib/tests/test_handlers_bcrypt.py | 21 +++++++++++++++++++++
 passlib/tests/test_handlers_django.py | 12 ++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 passlib/tests/conftest.py

diff --git a/passlib/tests/conftest.py b/passlib/tests/conftest.py
new file mode 100644
index 0000000..4c68161
--- /dev/null
+++ b/passlib/tests/conftest.py
@@ -0,0 +1,24 @@
+from typing import Any
+
+import pytest
+
+from passlib.handlers.bcrypt import bcrypt
+
+
+@pytest.fixture(scope="session")
+def bcrypt_backend_raises_on_wraparound() -> bool:
+    try:
+        bcrypt.hash(secret="abc" * 100)
+    except ValueError:
+        return True
+    return False
+
+
+@pytest.fixture(scope="class")
+def bcrypt_backend_raises_on_wraparound_unittest(
+    request: Any,
+    bcrypt_backend_raises_on_wraparound: bool,
+):
+    request.cls.bcrypt_backend_raises_on_wraparound = (
+        bcrypt_backend_raises_on_wraparound
+    )
diff --git a/passlib/tests/test_handlers_bcrypt.py b/passlib/tests/test_handlers_bcrypt.py
index 64fc8bf..d684ae0 100644
--- a/passlib/tests/test_handlers_bcrypt.py
+++ b/passlib/tests/test_handlers_bcrypt.py
@@ -8,6 +8,7 @@ import logging; log = logging.getLogger(__name__)
 import os
 import warnings
 # site
+import pytest
 # pkg
 from passlib import hash
 from passlib.handlers.bcrypt import IDENT_2, IDENT_2X
@@ -20,6 +21,7 @@ from passlib.tests.test_handlers import UPASS_TABLE
 #=============================================================================
 # bcrypt
 #=============================================================================
+@pytest.mark.usefixtures("bcrypt_backend_raises_on_wraparound_unittest")
 class _bcrypt_test(HandlerCase):
     """base for BCrypt test cases"""
     handler = hash.bcrypt
@@ -184,6 +186,22 @@ class _bcrypt_test(HandlerCase):
         # silence this warning, will come up a bunch during testing of old 2a hashes.
         warnings.filterwarnings("ignore", ".*backend is vulnerable to the bsd wraparound bug.*")
 
+        if getattr(self, 'bcrypt_backend_raises_on_wraparound', False):
+            type(self).known_correct_hashes = [
+                (s, h) for s, h in self.known_correct_hashes
+                if len(s) <= self.handler.truncate_size
+            ]
+
+    def test_secret_w_truncate_size(self):
+        if getattr(self, 'bcrypt_backend_raises_on_wraparound', False):
+            raise self.skipTest("bcrypt backend raises on passwords > 72 bytes")
+        super(_bcrypt_test, self).test_secret_w_truncate_size()
+
+    def test_77_fuzz_input(self, threaded=False):
+        if getattr(self, 'bcrypt_backend_raises_on_wraparound', False):
+            raise self.skipTest("bcrypt backend raises on passwords > 72 bytes")
+        super(_bcrypt_test, self).test_77_fuzz_input(threaded=threaded)
+
     def populate_settings(self, kwds):
         # builtin is still just way too slow.
         if self.backend == "builtin":
