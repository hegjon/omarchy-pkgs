pkgname=multipath-tools
pkgver=0.15.1
pkgrel=1
pkgdesc='Multipath tools for Linux (including kpartx)'
arch=('x86_64')
url='https://github.com/opensvc/multipath-tools'
license=('GPL-2.0-or-later' 'GPL-3.0-or-later' 'LGPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc'
         'device-mapper' 'libdevmapper.so'
         'json-c' 'libjson-c.so'
         'libaio' 'libaio.so'
         'libgcc' 'libgcc_s.so'
         'liburcu' #'liburcu.so'
         'systemd-libs' 'libsystemd.so' 'libudev.so'
         'util-linux-libs' 'libmount.so')
makedepends=('git' 'systemd')
source=("multipath-tools::git+https://github.com/opensvc/multipath-tools#tag=${pkgver}")
sha256sums=('86ac7493e49876914477f26854b040c5479e792c44a71cf6ca05d78ef053f6a2')

_make_opts=(
  prefix='/usr/'
  bindir='/usr/bin'
  etc_prefix=""
  configfile='/etc/multipath.conf'
  statedir='/etc/multipath'
  LIB='lib'
)


build() {
  cd "${pkgname}"

  make \
    "${_make_opts[@]}" \
    FORTIFY_OPT=''
}

package() {
  cd "${pkgname}"

  make -j1 \
    "${_make_opts[@]}" \
    DESTDIR="${pkgdir}" \
    install

  install -D -m0644 -t "${pkgdir}/usr/share/doc/${pkgname}" README*
}
