+        "@xla//xla/tsl/concurrency:executor",
         "@tsl//tsl/platform:protobuf",
     ],
 )
@@ -1635,6 +1636,7 @@ cc_library(
         ":framework_internal_headers_lib",
         ":lib",
         "@eigen_archive//:eigen3",
+        "@xla//xla/tsl/concurrency:executor",
     ] + if_static(
         extra_deps = [
             ":framework_internal_impl",
