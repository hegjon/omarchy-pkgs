# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=clap
pkgver=1.2.10
pkgrel=1
pkgdesc="CLever Audio Plugin API"
arch=(any)
url="https://github.com/free-audio/clap"
license=(MIT)
makedepends=(cmake)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('22c0de322ed48fea0011756864e4a0e5df838dc5554f0d8671dc9cbe3d888b0116ecb55b7ceee55a1735a65163d25745915e0164ab1624d1213ab72dd9ab7cb9')
b2sums=('769e0e4ced094bcc871a46ecdfd2af31d5d46e684976895a11efb6667a973e4d037038d1c41439e8df832350e8948df84baa4f7dff3a0a1be1dd843f0ab542c0')

build() {
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -S $pkgname-$pkgver
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $pkgname-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
