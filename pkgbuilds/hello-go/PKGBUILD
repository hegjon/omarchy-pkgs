# Maintainer: Jonny Heggheim <hegjon@gmail.com>

pkgname=hello-go
pkgver=0.1.0
pkgrel=1
pkgdesc="A tiny Go program that prints a quote, to exercise the farm's Go path"
arch=('x86_64')
url="https://github.com/hegjon/archci"
license=('MIT')
makedepends=('go')
depends=('glibc')
source=('main.go' 'go.mod' 'go.sum')
sha256sums=('c04f9c726eb663e844cf16d562e42c05e3bc0050ee7804bdfd0b8c9ecf6df72a'
            'b2a4e67dd59bc6f3e82e94498d71fdd722827663f680cb6e669e2dbb96adec66'
            '9ecaf40454f07b7c5c384751d5acbe7383e50b876b97c4f6d124ad5bd5153e6d')

prepare() {
  export GOTOOLCHAIN=local
  # fetch the module dependencies; the sourcer captures these into the source
  # package (vendor/go) and the worker replays them offline (GOPROXY=off)
  go mod download
}

build() {
  export GOTOOLCHAIN=local CGO_ENABLED=0
  go build -trimpath -ldflags '-s -w' -o hello-go .
}

package() {
  install -Dm755 hello-go "$pkgdir/usr/bin/hello-go"
}
