Build with GCC 15: its C23 default reads an empty parameter list as (void), which makes this 2018 release's own prototypes conflict, and incompatible pointer types are errors now.

--- a/PKGBUILD
+++ b/PKGBUILD
@@ -33,5 +33,7 @@
 build() {
   cd expect${pkgver}
+  # GCC 15 defaults to C23: expect's K&R-era prototypes need gnu17
+  export CFLAGS+=" -std=gnu17 -Wno-error=incompatible-pointer-types"
   ./configure --prefix=/usr --mandir=/usr/share/man
   make
 }
