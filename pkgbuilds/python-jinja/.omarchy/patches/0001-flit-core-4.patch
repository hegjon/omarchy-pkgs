Build with flit-core 4: the pyproject pin flit_core<4 predates it and nothing needs it.

--- a/PKGBUILD
+++ b/PKGBUILD
@@ -21,6 +21,8 @@
 
 prepare() {
   cd $_name-$pkgver
+  # flit_core<4 is a pin, not a need: flit-core 4 builds it (Arch has 4.0.2)
+  sed -i 's/flit_core<4/flit_core/' pyproject.toml
 }
 
 build() {
