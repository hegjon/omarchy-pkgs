# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Daniel Wallace <danielwallace at gtmanfred dot com>

pkgname=python-openstackclient
pkgver=10.3.0
pkgrel=1
pkgdesc="OpenStack Command-line Client"
arch=('any')
url="https://docs.openstack.org/python-openstackclient/latest/"
license=('Apache-2.0')
depends=('python-cryptography' 'python-cliff' 'python-iso8601' 'python-openstacksdk'
         'python-osc-lib' 'python-oslo-i18n' 'python-keystoneclient'
         'python-manilaclient' 'python-requests' 'python-stevedore')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-pbr')
checkdepends=('python-ddt' 'python-fixtures' 'python-hacking' 'python-requests-mock'
              'python-stestr' 'python-testtools' 'python-wrapt')
source=("git+https://github.com/openstack/python-openstackclient.git#tag=$pkgver")
sha512sums=('477b2a61006ccd258333bc0e8324ee50ba7672b67ae7f3c09d7a971067925d91ac4e1dce9c8f20a368f4a45f405ab9ee072f8e580adf840c81b181f131e523b4')

build() {
  cd python-openstackclient
  python -m build --wheel --no-isolation
}

check() {
  cd python-openstackclient
  # https://bugs.launchpad.net/python-openstackclient/+bug/2137223
  # test_endpoint_list_project_with_project_domain has a project_endpoints mock issue
  stestr run --exclude-regex "openstackclient.tests.unit.identity.v3.test_endpoint.TestEndpointList.test_endpoint_list_project_with_project_domain|openstackclient.tests.unit.identity.v3.test_endpoint.TestEndpointListServiceWithoutName.test_endpoint_list_project_with_project_domain"
}

package() {
  cd python-openstackclient
  python -m installer --destdir="$pkgdir" dist/*.whl
}
