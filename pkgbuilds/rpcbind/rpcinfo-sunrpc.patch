Use the official IANA service name, matching the rpcbind daemon patch.

Arch's services database names port 111 sunrpc, so resolving rpcbind or
portmapper fails before rpcinfo can contact the daemon.

--- a/src/rpcinfo.c
+++ b/src/rpcinfo.c
@@ -1835,8 +1835,8 @@
 
   /* Get the address of the rpcbind */
   memset (&hints, 0, sizeof hints);
-  if ((getaddrinfo (host, "rpcbind", &hints, &res) != 0) &&
+  if ((getaddrinfo (host, "sunrpc", &hints, &res) != 0) &&
       (getaddrinfo (host, "portmapper",&hints, &res) != 0))
     {
       rpc_createerr.cf_stat = RPC_N2AXLATEFAILURE;
       return (NULL);
