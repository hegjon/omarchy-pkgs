# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=valijson
pkgver=1.1.3
pkgrel=1
pkgdesc="Header-only JSON Schema validation library for C++"
url="https://github.com/tristanpenman/valijson"
arch=(any)
license=(BSD-2-Clause)
depends=(
  boost
)
makedepends=(
  cmake
  git
  ninja
  qt5-base
)
source=("git+$url#tag=v$pkgver")
b2sums=('a3d52cb714d390eb77b9441f218233a2c5630bf2f3552828a6cb812e9a567832cee83eaf177bfd8e7d8f0704c0c9e2e4a113c7a04ee6f0590821806b88f206d4')

build() {
  local cmake_options=(
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
  )

  cmake -S valijson -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure --stop-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 valijson/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

